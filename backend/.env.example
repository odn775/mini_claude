# 复制本文件为 backend/.env 后填写。backend/.env 不会提交到仓库。

# ===== LLM（阿里百炼 DashScope，OpenAI 兼容接口）=====
DASHSCOPE_API_KEY=
MINI_CLAUDE_MODEL=qwen3.7-max
MINI_CLAUDE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINI_CLAUDE_MAX_TOKENS=16384

# ===== 数据库（MySQL 8 + SQLAlchemy + Alembic）=====
DATABASE_URL=mysql+pymysql://mini_claude:mini_claude@127.0.0.1:3306/mini_claude?charset=utf8mb4

# ===== Web 服务监听地址 =====
MINI_CLAUDE_HOST=127.0.0.1
MINI_CLAUDE_PORT=8000

# ===== 运行数据目录（skills / 知识库索引 / mcp.json），默认 ~/.mini_claude =====
# MINI_CLAUDE_DATA_DIR=/data
